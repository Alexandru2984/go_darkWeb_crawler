# --- Go Specific ---
pkg/
bin/
vendor/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
cover.out
coverage.html

# Compiled backend binaries — build artifacts, regenerable via `make build`.
# Never commit these (they bloat git history and are a supply-chain/integrity risk).
backend/api
backend/api_bin
backend/crawler_bin
backend/onion-spider-api
backend/onion-spider-crawler
backend/*.prev
backend/tmp/
# Rollback copies kept next to the live binary during a deploy.
backend/*.old
backend/*.bak-*
# `make build` output — staging area before the binary is swapped into place.
tmp/

# --- Node/Frontend Specific ---
node_modules/
**/node_modules/
dist/
**/dist/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# --- Environment & Secrets ---
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
# Local backups (e.g. .env.bak.mailcow-20260509-184352) — contain secrets, never commit.
# .env.example stays tracked because it does not match any of these patterns.
.env.bak*
.env.backup*
.env.save*

# --- IDEs & Editors ---
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# --- OS Specific ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Project Specific Logs ---
*.log
logs/
