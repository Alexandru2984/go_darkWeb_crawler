# Weekly schedule for cloudflare-ips-update.service.
#
# Weekly rather than daily: Cloudflare changes its published ranges rarely, and
# each run fetches from an external host. Rather than nothing, which is what was
# running before — the list was last regenerated by hand and had already drifted
# out of date by the time it was checked.
#
# Install:
#   sudo cp deploy/systemd/cloudflare-ips-update.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cloudflare-ips-update.timer
#
# Check:  systemctl list-timers cloudflare-ips-update.timer
#         sudo /home/micu/swift+vapor/scripts/update-cloudflare-ips.sh --check

[Unit]
Description=Weekly Cloudflare IP range refresh for nginx

[Timer]
OnCalendar=weekly
# Catch up after downtime instead of silently skipping the missed window — the
# whole failure mode here is a list that quietly goes stale.
Persistent=true
# Spread the fetch out so it is not issued at the same instant as every other
# weekly job on the host.
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target
