# Production systemd unit for the Onion Spider API (go.micutu.com).
#
# This file is the source of truth; the live copy lives at
# /etc/systemd/system/onion-spider.service. Apply with:
#
#   sudo cp deploy/systemd/onion-spider.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl restart onion-spider
#
# Sandboxing rationale: the API parses attacker-influenced input (HTML scraped
# from onion services, JSON request bodies). If it is ever compromised, the
# blast radius must stop at this service — it must NOT be able to read the rest
# of the operator's home directory (~/.ssh, other projects' .env files) or write
# anywhere on the host. The app itself needs no write access at all: it writes
# only to Postgres and to stdout/journald.

[Unit]
Description=Onion Spider - Recursive Dark Web Crawler API
After=network.target postgresql.service tor.service
Wants=postgresql.service tor.service

[Service]
Type=simple
# Allocate a private, short-lived UID on every start. The API needs network
# access only; it must not share the deploy user's identity or home access.
DynamicUser=true
WorkingDirectory=/
ExecStart=/home/micu/go/backend/onion-spider-api
Restart=always
RestartSec=5
LimitNOFILE=65536
EnvironmentFile=/home/micu/go/backend/.env

# --- Filesystem isolation ---------------------------------------------------
# ProtectHome=tmpfs replaces /home with an empty tmpfs inside the service's
# mount namespace, then mounts back only the statically linked executable. The
# API cannot read source, .env, historical .env backups, deploy credentials,
# ~/.ssh or sibling projects. PID 1 reads EnvironmentFile before isolation.
# Deploy the CGO_ENABLED=0 artifact produced by `make build` before this unit.
ProtectHome=tmpfs
BindReadOnlyPaths=/home/micu/go/backend/onion-spider-api
ProtectSystem=strict
PrivateTmp=true

# The service never launches child programs. A whole-filesystem noexec policy,
# with one exception for its static binary, prevents an injected shell/tool
# from being executed after an application compromise.
NoExecPaths=/
ExecPaths=/home/micu/go/backend/onion-spider-api

# --- Privilege and kernel isolation -----------------------------------------
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateUsers=true
PrivateIPC=true
RemoveIPC=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

# Outbound traffic is TCP to Postgres/Tor/SMTP. No Unix, raw, netlink or
# Bluetooth sockets; the only listener the process may bind is its loopback API.
RestrictAddressFamilies=AF_INET AF_INET6
SocketBindDeny=any
SocketBindAllow=tcp:8900

# Secrets in .env must not be world-readable if the process ever creates files.
UMask=0077

[Install]
WantedBy=multi-user.target
