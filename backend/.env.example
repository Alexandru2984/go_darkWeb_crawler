DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/onion_spider?sslmode=disable
PORT=8900
TOR_PROXY=127.0.0.1:9050
WORKERS=3
MAX_DEPTH=2

# Secret JWT — obligatoriu. Minim 32 caractere.
# Genereaza cu: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_WITH_openssl_rand_hex_32

# Origini permise pentru CORS (separate cu virgula).
CORS_ORIGIN=https://example.com

# Baza URL folosita in linkul din emailul de verificare (fallback: CORS_ORIGIN[0]).
VERIFY_URL_BASE=https://example.com

# Primul user care se inregistreaza cu acest email devine admin,
# dar DOAR daca nu exista inca niciun admin in DB. Lasa gol pentru a dezactiva.
ADMIN_EMAIL=

# SMTP pentru emailuri de verificare (lasa gol pentru dev — emailurile nu se trimit).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@example.com

# Revive sweeper: how long a node must sit in 'failed' before it is returned to
# the queue, and how many are revived per hourly pass.
#
# 'failed' is terminal for the scheduler, so without this an outage lasting
# longer than a node's retry budget kills the queue permanently: every node
# exhausts its retries, nothing is left pending, and the crawler stays idle even
# after the cause is fixed.
#
# REVIVE_BATCH bounds the UPDATE so it does not lock tens of thousands of rows
# at once, and makes recovery gradual enough to observe and stop. It does not
# throttle crawling — the per-domain delay is applied when a node is claimed,
# not when it is queued — so this number is unrelated to crawl throughput and
# the pending queue may grow faster than workers drain it.
REVIVE_FAILED_AFTER_DAYS=7
REVIVE_BATCH=500

# Tor control port — used only for SIGNAL NEWNYM (circuit rotation after a run
# of failures). Without it the crawler still works; it just cannot rotate away
# from a bad circuit, so a failing guard path stalls the queue until restart.
#
# Requires the matching directives in /etc/tor/torrc:
#   ControlPort 127.0.0.1:9051
#   HashedControlPassword <output of: tor --hash-password YOUR_PASSWORD>
#
# Prefer the password over the cookie when Tor is shared with other services.
# CookieAuthentication makes the cookie readable by the debian-tor group, so
# using it means adding this app's user to that group — which hands every
# process running as that user full control of the Tor daemon, including any
# hidden services it hosts. The password is scoped to this app's 0600 .env.
TOR_CONTROL_ADDR=127.0.0.1:9051
TOR_CONTROL_PASSWORD=
# Leave empty when using password auth — the cookie is tried first if set.
TOR_CONTROL_COOKIE=
